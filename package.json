{
  "name": "norieco-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:database": "npx --yes deno test --node-modules-dir=auto --allow-read --allow-env supabase/tests/marketplace_test.ts supabase/tests/starter_portal_test.ts supabase/tests/pdv_trials_test.ts ../vendapeixe/supabase/tests/trial_onboarding_handler_test.ts ../vendapeixe/supabase/tests/panel_session_handler_test.ts",
    "test:bridge": "node tests/management-bridge-browser.mjs",
    "test:catalog": "node tests/catalog-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
